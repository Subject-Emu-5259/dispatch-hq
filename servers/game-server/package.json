{
  "name": "@dispatch-hq/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/serve-combined.js",
    "db:migrate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dispatch-hq/shared": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "@hono/node-ws": "^1.3.1",
    "bullmq": "^5.46.0",
    "drizzle-orm": "^0.44.1",
    "hono": "^4.7.7",
    "ioredis": "^5.6.1",
    "jose": "^6.2.5",
    "postgres": "^3.4.5",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
